Direction":"column","flexWrap":"nowrap","height":"auto","justifyContent":"flex-start","padding":"0px 40px","width":"1440px"},"tagName":"","uuid":"d7cce0d9-e98e-42d8-8cd9-3dade35dcc62"}],"name":"プライバシーポリシー","style":{"&appear":{"opacity":"0","transitionDelay":"200ms","transitionDuration":"800ms","transitionTimingFunction":"cubic-bezier(0.445, 0.05, 0.55, 0.95)"},"@mobile":{"alignContent":"center","alignItems":"center","justifyContent":"center","margin":"0px 0px 40px 0px","padding":"48px 20px"},"@tablet":{"padding":"64px 0px"},"alignContent":"center","alignItems":"center","background":"rgba(0,0,0,0.0)","borderBottom":"1px solid #333333","borderLeft":"0px solid #333333","borderRight":"0px solid #333333","borderTop":"0px solid #333333","flex":"none","flexDirection":"column","flexWrap":"nowrap","height":"auto","justifyContent":"center","margin":"0px 0px 40px 0px","padding":"72px 0px","width":"100%"},"tagName":"","uuid":"afeecdd3-9aaf-4860-90f3-86803e735e87"},{"content":{"data":"1.個人情報保護方針","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"h1","uuid":"43a68821-2110-4d65-a8aa-921edfce6b48","children":[]},{"content":{"data":"このプライバシーポリシーは、株式会社リコントキャリアが運営するMayro Pilates Studio（以下「当社」と表記）のサービスを安心してご利用頂くために、当社が個人情報をどのように取扱うかを説明しております。","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"0539d9f7-55dd-44b5-a50f-d4093e54fa13","children":[]},{"content":{"data":"ご利用頂く前に、当サイトのプライバシーポリシーをお読みになり、内容に同意をされた上、ご利用頂くようお願い致します。このプライバシーポリシーが適用されるのは、当サイトのみとなります。<br><br>","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"7996fa91-646a-4545-9bd0-f39279c52f3a","children":[]},{"content":{"data":"2.個人情報の収集と利用について","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"d180310a-60ee-4699-9e65-84ce5eac4dc1","children":[]},{"content":{"data":"１）当社では、皆様にピラティススタジオのサービスをご提供するために、会員登録や体験レッスンの予約時に、氏名、年齢、性別、住所、電話番号、E-mailアドレス、及び安全なレッスン提供を目的とした過去のケガや現在の健康状態に関する情報等をお預かりします。頂いた情報は、ご予約の管理、レッスンの提供、スタジオからのご案内やご連絡、サービスの向上・改善のために使用いたします。これら必要な個人情報のご提供がない場合には、当社のサービス（レッスンの受講など）を受けられない場合がございます。","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"6c151540-20e9-46fa-9a78-b2658075959d","children":[]},{"content":{"data":"２）本サイトのお問い合わせフォーム等からお預かりした氏名、E-mailアドレス等の個人情報は、お問い合わせに対する回答や必要なご連絡の目的のみに使用し、他の目的で使用することはございません。","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"0be43193-e813-4b79-baff-15f8529c733d","children":[]},{"content":{"data":"<br>","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"635ad9ef-4133-4e45-a248-29d19a0039e2","children":[]},{"content":{"data":"3.個人情報の第三者への開示・提供の禁止","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"322f1f81-8537-4c16-addb-ba6d80ab3810","children":[]},{"content":{"data":"当社では収集した個人情報に関して、原則としてお客様本人の許可なく個人情報を第三者に開示いたしません。ただし、裁判所、警察、税務署、消費生活センター、その他の法律や条例などで認められた権限を持つ機関から要請がある場合には、これに応じて本人の許可なく開示させていただくことがございます。","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"8df7ff97-dcee-432a-9ac8-203bda7af588","children":[]},{"content":{"data":"１）利用者が第三者に不利益を及ぼすと判断した場合","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"h1","uuid":"1f946388-476e-4ff9-982c-425365e46b64","children":[]},{"content":{"data":"２）公衆衛生の向上または児童の健全な育成の推進のために特に必要がある場合であって、利用者本人の承諾を得ることが困難である場合","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"e1e07c85-c736-43cc-aa88-7dce3128f2eb","children":[]},{"content":{"data":"３）国の機関若しくは地方公共団体またはその委託を受けた者が法令の定める事務を遂行することに対して協力する必要がある場合で、利用者本人の同意を得ることによりその事務の遂行に支障を及ぼすおそれがある場合","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"e39fa586-95f4-436a-9d85-f7df64440aac","children":[]},{"content":{"data":"４）裁判所、検察庁、警察またはこれらに準じた権限を有する機関から、個人情報についての開示を求められた場合","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"dcd989ce-602a-4057-a40c-8e7e8f26faae","children":[]},{"content":{"data":"５）利用者本人から明示的に第三者への開示または提供を求められた場合","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"bbfaf1ef-7824-44d0-b09c-86cb135ff0a9","children":[]},{"content":{"data":"６）法令により開示または提供が許容されている場合","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"19003ae0-e889-44b5-97a6-2d707fe0486c","children":[]},{"content":{"data":"７）合併その他の事由による事業の承継に伴い個人情報を提供する場合であって、承継前の利用目的の範囲で取り扱われる場合<br><br>","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"e1568133-7262-420d-8a05-fddaea8fcbca","children":[]},{"content":{"data":"4.個人情報の安全対策","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"9052cb47-dca9-464e-8f38-51c9b634b9ed","children":[]},{"content":{"data":"当社は、個人情報の正確性及び安全性確保のために、セキュリティに万全の対策を講じています。<br><br>","type":"text"},"name":"Text","style":{"color":"#333333","flex":"none","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"9dc2b7e1-9a7e-4816-8009-e778f1a52083","children":[]},{"content":{"data":"5.SSLの使用とアクセスログについて","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"eae67280-b322-43d3-bc46-5f64530abe60","children":[]},{"content":{"data":"当サイトでは、お客様の個人情報を安全に送受信するため、SSL（Secure Sockets Layer）暗号化通信を使用しております。また、当社のウェブサイトではログファイルを収集しております。但し、これら収集した情報は、お客様のウェブの利用状況を把握するための統計的情報としてのみ使用し、個人情報にはリンクしておりません。<br><br>","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"b12395b2-f95d-4a9f-ae83-41224685eb66","children":[]},{"content":{"data":"6.法令規範の遵守と見直し/プライバシーポリシーの変更","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"fda9c462-7b5c-4900-9d6f-14ee9cb35d35","children":[]},{"content":{"data":"当社は、保有する個人情報に関して適用される日本の法令、その他規範を遵守するとともに、本ポリシーの内容を適宜見直し、その改善に努めます。","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"c23556ae-3b95-4099-ae46-6cd17fbcb8ad","children":[]},{"content":{"data":"又、プライバシーポリシーを変更する場合には、その変更内容について、当社ウェブサイトに掲載いたします。それにより、当社のウェブサイトご利用になられる皆様に、当社がどのような個人情報を収集し、どのようにその個人情報を使用するかを、常にお知らせしております。当サイトを通じて収集した個人情報は、収集当初の目的にのみ利用します。<br><br>","type":"text"},"name":"Text","style":{"color":"#333333","fontFamily":"var(--s-font-ad9deb87)","fontSize":"20px","fontWeight":400,"height":"auto","letterSpacing":"normal","lineHeight":"1.4","textAlign":"left","width":"auto"},"tagName":"","uuid":"50492bca-edae-4111-88da-e6f0e786e048","children":[]},{"content":{"data":"第1版 2025年7月22日 制定","type":"tex